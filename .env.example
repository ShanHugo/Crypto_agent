### 模式（預設模擬；要下真單必須兩個都改，見 docs/DESIGN.md 5.7）
DRY_RUN=1
LIVE_CONFIRM=

### MAX API（只開 Read + Trade，禁止 Withdraw，設定 IP 白名單；DRY_RUN=1 時不會載入）
MAX_API_KEY=
MAX_API_SECRET=

### Discord 推送（webhook 網址等同密碼，不要上傳）
DISCORD_WEBHOOK_URL=
# 模擬帳戶專用頻道（沒填就送到 DISCORD_WEBHOOK_URL）
PAPER_WEBHOOK_URL=

### 備份位置（多個用 ; 分隔；空白 = %USERPROFILE%\CryptoRobotBackup）。建議至少一個在另一顆硬碟
BACKUP_DIRS=
